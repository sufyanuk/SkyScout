# ─── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+: local, Docker, Neon, Supabase, Prisma Postgres…
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyscout"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Required. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Optional OAuth providers — buttons appear automatically when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Flight data ─────────────────────────────────────────────────────────────
# "mock" (default) works offline with realistic generated fares.
# "live" uses RealFlightProvider (src/lib/flights/real-provider.ts) once implemented.
FLIGHT_PROVIDER="mock"
# Server-only credentials for a real flight API (never exposed to the browser).
FLIGHT_API_BASE_URL=""
FLIGHT_API_KEY=""
FLIGHT_API_SECRET=""

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Protects GET /api/cron/alerts (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=""
